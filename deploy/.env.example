# 复制为仓库根目录下的 .env 后修改（.env 已被 .gitignore 排除，切勿提交）。
# 所有配置项都以 ZONGCE_ 开头，也可以直接设为环境变量。

# 数据库：本机默认 SQLite；部署时改为 MySQL 8，例如
# ZONGCE_DATABASE_URL=mysql+pymysql://zongce:<密码>@127.0.0.1:3306/zongce
ZONGCE_DATABASE_URL=sqlite:///./data/zongce.sqlite3

# JWT 签名密钥：至少 32 个字符的随机串。生成方法：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ZONGCE_JWT_SECRET=请替换为随机生成的长字符串

# 登录有效期（分钟）
ZONGCE_JWT_EXPIRE_MINUTES=480

# 证明材料存放目录与单个文件大小上限（字节）
ZONGCE_UPLOAD_DIR=./uploads
ZONGCE_MAX_UPLOAD_BYTES=10485760
ZONGCE_MAX_FILES_PER_DECLARATION=10

# 公示默认天数（办法正文第十四条：3 天）
ZONGCE_PUBLICATION_DAYS=3

# 允许跨域访问的前端地址（JSON 数组），本机开发前端时例如 ["http://localhost:5173"]
ZONGCE_CORS_ORIGINS=[]
