{
  "name": "zongce-frontend",
  "private": true,
  "description": "综测智能核算平台前端（Vue 3 + Vite + TypeScript）。不实现任何计分逻辑，计分一律调用后端（CLAUDE.md §6）。",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:e2e": "vite build && playwright test",
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "openapi-fetch": "0.17.0",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.13"
  }
}
